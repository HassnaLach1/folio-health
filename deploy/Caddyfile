{$APP_HOST} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000"
    }
    route {
        # Browser calls share the app origin. This is an additional browser safeguard;
        # authentication and database ownership policies enforce record access.
        @foreignOrigin expression `{http.request.header.Origin} != "" && {http.request.header.Origin} != "{$SITE_URL}"`
        respond @foreignOrigin "Origin not allowed" 403
        @api path /api/auth/v1/* /api/rest/v1/* /api/storage/v1/*
        handle @api {
            uri strip_prefix /api
            reverse_proxy api-gw:8000 {
                header_up X-Forwarded-Host {host}
                header_up X-Forwarded-Proto https
                header_up X-Forwarded-Port 443
                header_up -X-Forwarded-Prefix
            }
        }
        # Never expose Studio, postgres-meta, database ports, or unused API routes.
        handle /api/* {
            respond "Not found" 404
        }
        handle {
            reverse_proxy web:80
        }
    }
}

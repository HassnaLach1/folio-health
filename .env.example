# Public client configuration. Blank values enable synthetic demo mode only.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_REQUIRE_MFA=true
# Native doctor links need a LAN-reachable Expo web preview URL, for example http://192.168.1.20:8081.
EXPO_PUBLIC_DOCTOR_VIEW_URL=

# Worker-only secrets. NEVER prefix secrets with EXPO_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Worker extraction engine. Local is the default. Bedrock sends page images to AWS only when explicitly selected.
EXTRACTION_ENGINE=local
EXTRACTION_FALLBACK=local
AWS_REGION=eu-west-1
AWS_BEDROCK_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0
# Optional accuracy alternative: eu.anthropic.claude-sonnet-4-6
# AWS credentials must remain worker-only. Prefer a temporary AWS profile/role.
# For a local trial, a short-term Bedrock key can be supplied instead (expires within 12 hours).
# AWS_BEARER_TOKEN_BEDROCK=
# Optional Azure Document Intelligence OCR provider. Configure only after privacy review.
AZURE_DOCUMENT_ENDPOINT=
AZURE_DOCUMENT_KEY=

# Local Supabase Google OAuth credentials (server-only; NEVER use EXPO_PUBLIC_).
# Create a Web application OAuth client in Google Auth Platform first.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

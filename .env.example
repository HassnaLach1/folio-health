# Public client configuration. Blank values enable synthetic demo mode only.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Worker-only secrets. NEVER prefix secrets with EXPO_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional Azure Document Intelligence OCR provider. Configure only after privacy review.
AZURE_DOCUMENT_ENDPOINT=
AZURE_DOCUMENT_KEY=
